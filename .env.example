# Anthropic (https://console.anthropic.com/settings/keys): every language job runs on Claude.
ANTHROPIC_API_KEY=
# Web search (https://exa.ai).
EXA_API_KEY=

# Models are "anthropic:<model-id>".
# MAIN_MODEL answers (Claude Sonnet 5.5); SMALL_MODEL plans and writes memories (Claude Haiku 5.5).
MAIN_MODEL=anthropic:claude-sonnet-5-5
SMALL_MODEL=anthropic:claude-haiku-5-5
# For cheaper answers (about 20x less), at some cost in quality: MAIN_MODEL=anthropic:claude-haiku-5-5
# Optional backup Claude model for all three jobs, used when a model errors or doesn't start
# replying within 20s, e.g. anthropic:claude-haiku-5-5. "none" means no backup.
FALLBACK_MODEL=none

# Embeddings run in-process with EmbeddingGemma, because Anthropic has no embedding model.
# No key needed; the model downloads once (about 310 MB) on first run.
EMBEDDING_MODEL=local:onnx-community/embeddinggemma-300m-ONNX

DATA_DIR=./data
PORT=3000
